# Environment for the gateway: placeholders and defaults only.
#
# Copy this file to .env, which is gitignored, and fill in what you need:
#   cp .env.example .env
# Load it into your shell before `make run`:
#   set -a; . ./.env; set +a
#
# Never put a real key in .env.example: it is committed to git.

# --- Gateway ---

# Path of the config file. Optional; the default is config.yaml.
GATEWAY_CONFIG=config.yaml

# Required. At least 32 characters, and not a gw_ key. Generate one with:
#   openssl rand -hex 32
GATEWAY_ADMIN_KEY=

# Required. Here, the compose database that `make db-up` starts.
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/gateway?sslmode=disable

# --- Provider keys ---

# Needed only by the providers in your config. A provider whose key is unset or
# empty stops the gateway at startup, so fill in the keys you use and delete the
# other providers from config.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Ollama ---

# All optional. Each default below is what config.yaml uses when the variable
# is unset or empty.

# Where Ollama listens.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Seconds to wait for Ollama's response headers. A non-streaming reply sends
# none until it is done, so this covers the whole generation, model load
# included.
OLLAMA_TIMEOUT_SECONDS=120

# Requests sent to Ollama at once. 0 is unlimited.
OLLAMA_MAX_CONCURRENCY=1

# Seconds a request waits for a free slot before it gets a 503.
OLLAMA_QUEUE_TIMEOUT_SECONDS=30

# true retries a failed non-streaming request on Groq, which costs real money.
OLLAMA_FALLBACK_ENABLED=false
