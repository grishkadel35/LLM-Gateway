# Compiled binaries
/bin/
# Leading slash anchors this to the repo root. Without it the pattern would
# also match the cmd/gateway/ directory and silently ignore new files in it.
/gateway

# Test and coverage output
*.test
*.out
coverage.html

# Local config overrides — keep secrets and machine-specific settings out of git
config.local.yaml
.env
.env.*
# The example holds placeholders only, so it is committed.
!.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
claude.md
llm-gateway-roadmap.md
# Local plan and task list (/plan, /build)
/tasks/

# graphify knowledge graph output (regenerate with /graphify)
/graphify-out/

# Personal Claude Code settings
.claude/settings.local.json
