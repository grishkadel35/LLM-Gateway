{
  "uid": "llm-gateway",
  "title": "LLM Gateway",
  "tags": [],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 42,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Requests answered on the provider routes, by the route called. The gateway's own refusals count too.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(gateway_requests_total[1m]))",
          "legendFormat": "{{provider}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate by provider",
      "description": "Share of each provider's requests answered with a 5xx, and, apart, the share the gateway refused itself (rate limit or budget). Empty while a provider has no traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^5xx/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "shades",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^refused/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "shades",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (provider) (rate(gateway_requests_total{status=~\"5..\"}[1m])) or 0 * sum by (provider) (rate(gateway_requests_total[1m]))) / (sum by (provider) (rate(gateway_requests_total[1m])) > 0)",
          "legendFormat": "5xx {{provider}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "(sum by (provider) (rate(gateway_ratelimit_rejections_total[1m]) or rate(gateway_budget_rejections_total[1m])) or 0 * sum by (provider) (rate(gateway_requests_total[1m]))) / (sum by (provider) (rate(gateway_requests_total[1m])) > 0)",
          "legendFormat": "refused {{provider}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency by provider (p50, p95, p99)",
      "description": "Time to serve a request, a streamed body included, by the route called.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (provider, le) (rate(gateway_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{provider}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(gateway_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{provider}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (provider, le) (rate(gateway_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 {{provider}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gateway overhead vs upstream TTFB (p50, p95, p99)",
      "description": "The gateway's own work before a provider sees a request, against the provider's time to response headers, all providers together. Log scale: the two differ by orders of magnitude. For a request that isn't streamed, TTFB is about the whole generation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^overhead/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "shades",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^TTFB/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "shades",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gateway_overhead_seconds_bucket[1m])))",
          "legendFormat": "overhead p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_overhead_seconds_bucket[1m])))",
          "legendFormat": "overhead p95",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_overhead_seconds_bucket[1m])))",
          "legendFormat": "overhead p99",
          "instant": false,
          "range": true
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gateway_upstream_ttfb_seconds_bucket[1m])))",
          "legendFormat": "TTFB p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_upstream_ttfb_seconds_bucket[1m])))",
          "legendFormat": "TTFB p95",
          "instant": false,
          "range": true
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_upstream_ttfb_seconds_bucket[1m])))",
          "legendFormat": "TTFB p99",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "Hits as a share of hits plus misses; bypasses are left out. Empty while no request reaches the cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(gateway_cache_requests_total{result=\"hit\"}[1m])) or vector(0)) / (sum(rate(gateway_cache_requests_total{result=~\"hit|miss\"}[1m])) > 0)",
          "legendFormat": "hit rate",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token throughput by type",
      "description": "Tokens the providers reported, per second, by type.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(gateway_tokens_total[1m]))",
          "legendFormat": "{{type}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token throughput by model",
      "description": "Tokens the providers reported, per second, by model. A model outside the price table shows as other.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(gateway_tokens_total[1m]))",
          "legendFormat": "{{model}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Budget utilization per tenant",
      "description": "The ledger's spend as a share of the tenant's budget. A tenant appears once it sends a paid request after the gateway starts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_budget_spent_micros / (gateway_budget_micros > 0)",
          "legendFormat": "{{tenant}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Spend per hour by tenant",
      "description": "What the providers' usage reports cost at the last minute's rate, in dollars per hour. Known costs only.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (rate(gateway_cost_micros_total[1m])) * 3600 / 1e6",
          "legendFormat": "{{tenant}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Gateway health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Refusals by kind",
      "description": "Requests the gateway refused itself, per second: rate limits, and budget refusals by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_ratelimit_rejections_total[1m]))",
          "legendFormat": "rate limited",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(gateway_budget_rejections_total[1m]))",
          "legendFormat": "budget {{reason}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Usage writer",
      "description": "Rows waiting in the usage writer's queue (left axis), which drops rows past 10,000, and rows dropped in the last minute (right axis).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_usage_writer_queue_depth",
          "legendFormat": "queued rows",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "increase(gateway_usage_writer_dropped_total[1m])",
          "legendFormat": "dropped in the last minute",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Provider up",
      "description": "The latest health check of each provider that has a health_path. Other providers have no series.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "index": 0,
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "index": 1,
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 16,
          "valueSize": 36
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_provider_up",
          "legendFormat": "{{provider}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Fallbacks",
      "description": "Requests handed from a failed provider to its fallback, per second, by why it failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from, to, reason) (rate(gateway_fallbacks_total[1m]))",
          "legendFormat": "{{from}} to {{to}} ({{reason}})",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
